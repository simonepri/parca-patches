From df4234670e4c1d1ec08a8ad370d546911080fb72 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <3505087+simonepri@users.noreply.github.com>
Date: Wed, 25 Nov 2026 22:27:17 +0000
Subject: [PATCH] pkg/query: store merge profile timestamps in milliseconds

The merge query paths of both queriers stored the query start in
Meta.Timestamp as nanoseconds, while the single-profile paths store
milliseconds and the pprof writer multiplies Meta.Timestamp by 1e6 to get
TimeNanos. For any current start time that multiplication overflows int64,
so a merged pprof download carries a wrapped time, such as 2023-10-15 for
a query that started in 2026.

Store milliseconds in both merge paths and add a test that downloads a
merged pprof profile and checks its time is the query start.
---
 pkg/clickhouse/querier.go     |   3 +-
 pkg/parcacol/querier.go       |   3 +-
 pkg/query/merge_pprof_test.go | 109 ++++++++++++++++++++++++++++++++++
 3 files changed, 113 insertions(+), 2 deletions(-)
 create mode 100644 pkg/query/merge_pprof_test.go

diff --git a/pkg/clickhouse/querier.go b/pkg/clickhouse/querier.go
index 96716c7..1494922 100644
--- a/pkg/clickhouse/querier.go
+++ b/pkg/clickhouse/querier.go
@@ -663,7 +663,8 @@ func (q *Querier) QueryMerge(
 		return profile.Profile{}, err
 	}
 
-	qp.Meta.Timestamp = startNanos
+	// Meta.Timestamp is in milliseconds, like the single-profile path.
+	qp.Meta.Timestamp = start.UnixMilli()
 
 	return profile.Profile{
 		Meta:    qp.Meta,
diff --git a/pkg/parcacol/querier.go b/pkg/parcacol/querier.go
index 8a49ee6..e09dafd 100644
--- a/pkg/parcacol/querier.go
+++ b/pkg/parcacol/querier.go
@@ -1510,7 +1510,8 @@ func (q *Querier) selectMerge(
 	}
 
 	queryParts.Meta.SampleType = resultType
-	queryParts.Meta.Timestamp = start
+	// Meta.Timestamp is in milliseconds, like the single-profile path; start is in nanoseconds.
+	queryParts.Meta.Timestamp = startTime.UnixMilli()
 
 	return records, "sum(value)", queryParts, nil
 }
diff --git a/pkg/query/merge_pprof_test.go b/pkg/query/merge_pprof_test.go
new file mode 100644
index 0000000..ac78fdf
--- /dev/null
+++ b/pkg/query/merge_pprof_test.go
@@ -0,0 +1,109 @@
