-  // Attempt a lightweight permission probe. CUPTI PC sampling requires
-  // either root, CAP_SYS_ADMIN, or the NVIDIA module parameter
-  // NVreg_RestrictProfilingToAdminUsers=0.
-  // We cannot easily pre-check permissions without attempting CUPTI calls,
-  // so we defer the real check to initialize() where enablePCSampling()
-  // will fail with a CUPTI error if permissions are insufficient.
-  // TODO: Add explicit permission pre-check.
-  // Reference: https://developer.nvidia.com/nvidia-development-tools-solutions-err_nvgpuctrperm-permission-issue-performance-counters
+  // Without access to the performance counters, CUPTI accepts PC sampling
+  // and then finalizes itself at the first kernel launch, silencing all of
+  // parcagpu (profiling_access.h).
+  if (!profilingAllowed()) {
+    PLOG_WARN(0, kLogComponent,
+              "PC sampling disabled: the NVIDIA driver restricts GPU "
+              "profiling to admin users (NVreg_RestrictProfilingToAdminUsers"
+              "=1) and this process lacks CAP_SYS_ADMIN; see "
+              "https://developer.nvidia.com/"
+              "nvidia-development-tools-solutions-err_nvgpuctrperm-permission-"
+              "issue-performance-counters");
+    return false;
+  }
 
   int major = driverVersion / 1000;
   int minor = (driverVersion % 1000) / 10;
diff --git a/src/profiling_access.h b/src/profiling_access.h
new file mode 100644
index 0000000..4269b59
--- /dev/null
+++ b/src/profiling_access.h
@@ -0,0 +1,54 @@
+// Copyright 2026 The Parca Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#ifndef PARCAGPU_PROFILING_ACCESS_H_
+#define PARCAGPU_PROFILING_ACCESS_H_
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace parcagpu {
+
+// Whether the NVIDIA driver lets this process use the GPU performance
+// counters that PC sampling needs. With NVreg_RestrictProfilingToAdminUsers=1
+// (the default, shown as "RmProfilingAdminOnly: 1" in the driver's params)
+// only processes with CAP_SYS_ADMIN may, whatever their uid. CUPTI doesn't
+// say so up front: cuptiPCSamplingEnable and the configuration calls succeed,
+// and at the first module load or kernel launch CUPTI fails with
+// CUPTI_ERROR_INSUFFICIENT_PRIVILEGES and finalizes itself, which drops
+// parcagpu's subscriber and every activity kind along with PC sampling.
+// True when the driver doesn't say (no params file, or no such line).
+inline bool profilingAllowed(const char *params = "/proc/driver/nvidia/params",
+                             const char *status = "/proc/self/status") {
+  FILE *f = fopen(params, "r");
+  if (!f)
+    return true;
+  char line[256];
+  int adminOnly = 0;
+  while (fgets(line, sizeof(line), f)) {
+    if (sscanf(line, "RmProfilingAdminOnly: %d", &adminOnly) == 1)
+      break;
+  }
+  fclose(f);
+  if (adminOnly == 0)
+    return true;
+
+  f = fopen(status, "r");
+  if (!f)
+    return false;
+  unsigned long long capEff = 0;
+  while (fgets(line, sizeof(line), f)) {
+    if (strncmp(line, "CapEff:", 7) == 0) {
+      capEff = strtoull(line + 7, nullptr, 16);
+      break;
+    }
+  }
+  fclose(f);
+  constexpr int kCapSysAdmin = 21;
+  return (capEff >> kCapSysAdmin) & 1;
+}
+
+} // namespace parcagpu
+
+#endif // PARCAGPU_PROFILING_ACCESS_H_
diff --git a/test/test_profiling_access.cpp b/test/test_profiling_access.cpp
new file mode 100644
index 0000000..be39cbf
--- /dev/null
+++ b/test/test_profiling_access.cpp
@@ -0,0 +1,76 @@
+// Copyright 2026 The Parca Authors
+// SPDX-License-Identifier: Apache-2.0
+//
+// Unit test for profiling_access.h: reading the driver's profiling
+// restriction and the process's CAP_SYS_ADMIN. No GPU needed.
+
+#include "profiling_access.h"
+
+#include <cstdio>
+#include <string>
+#include <unistd.h>
+
+using namespace parcagpu;
+
+static int failures = 0;
+
+#define CHECK(cond)                                                            \
+  do {                                                                         \
+    if (!(cond)) {                                                             \
+      fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);          \
+      failures++;                                                              \
+    }                                                                          \
+  } while (0)
+
+static void writeFile(const std::string &path, const char *text) {
+  FILE *f = fopen(path.c_str(), "w");
+  fputs(text, f);
+  fclose(f);
+}
+
+int main() {
+  char tmpl[] = "/tmp/parcagpu-prof-XXXXXX";
+  const char *root = mkdtemp(tmpl);
+  if (!root) {
+    perror("mkdtemp");
+    return 1;
+  }
+  const std::string params = std::string(root) + "/params";
+  const std::string status = std::string(root) + "/status";
+  const char *p = params.c_str(), *s = status.c_str();
+
+  // No driver params: nothing known, allowed.
+  CHECK(profilingAllowed(p, s));
+
+  writeFile(status, "Name:\tpython\nCapInh:\t0000000000000000\n"
+                    "CapEff:\t0000000000000000\nCapBnd:\t00000000a80425fb\n");
+  writeFile(params, "ResmanDebugLevel: 4294967295\nRmProfilingAdminOnly: 1\n"
+                    "EnableMSI: 1\n");
+  CHECK(!profilingAllowed(p, s)); // restricted, no capabilities
+  writeFile(status, "CapEff:\t00000000a80425fb\n");
+  CHECK(!profilingAllowed(p, s)); // container root: no CAP_SYS_ADMIN
+  writeFile(status, "CapEff:\t000001ffffffffff\n");
+  CHECK(profilingAllowed(p, s)); // privileged
+  writeFile(status, "CapEff:\t0000000000200000\n");
+  CHECK(profilingAllowed(p, s)); // CAP_SYS_ADMIN alone
+
+  writeFile(status, "CapEff:\t0000000000000000\n");
+  writeFile(params, "ResmanDebugLevel: 4294967295\nRmProfilingAdminOnly: 0\n");
+  CHECK(profilingAllowed(p, s)); // unrestricted
+  writeFile(params, "ResmanDebugLevel: 4294967295\n");
+  CHECK(profilingAllowed(p, s)); // driver doesn't say
+
+  writeFile(params, "RmProfilingAdminOnly: 1\n");
+  unlink(s);
+  CHECK(!profilingAllowed(p, s)); // restricted, capabilities unknown
+
+  unlink(p);
+  rmdir(root);
+
+  if (failures) {
+    fprintf(stderr, "%d failure(s)\n", failures);
+    return 1;
+  }
+  printf("PASS\n");
+  return 0;
+}
