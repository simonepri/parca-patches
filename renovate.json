{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    ":enablePreCommit"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates when CI checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge upstream Parca minor/patch updates when CI passes",
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Use unscoped feat commit type for upstream updates",
      "matchPackageNames": [
        "parca-dev/parca",
        "parca-dev/parcagpu"
      ],
      "semanticCommitType": "feat",
      "semanticCommitScope": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump upstream commits pinned in mise.toml to the latest commit on their branch",
      "fileMatch": [
        "^mise\\.toml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>git-refs)\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\n.*?=\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^mise\\.toml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?!git-refs)(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\n.*?=\\s*\"?(?<currentValue>v?[0-9.]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^readme\\.md$"
      ],
      "matchStrings": [
        "<!--\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\s*-->\\n\\[!\\[.*?\\]\\(https://img\\.shields\\.io/badge/.*-(?<currentValue>v?[0-9.]+)-[^)]*\\)\\]\\(https://github\\.com/.*?/releases/tag/.*?\\)"
      ]
    }
  ]
}
